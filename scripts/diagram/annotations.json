    "lane": "github",
    "stage": 4,
    "cost": "free",
    "note": "build, links, evals, formatting — on every push"
  },
  "wf:preview": {
    "lane": "github",
    "stage": 5,
    "cost": "free",
    "note": "every PR gets a live URL"
  },
  "wf:claude-code-review": {
    "lane": "github",
    "stage": 5,
