---
import '../styles/global.css';
import { isPreview } from '../lib/build-info.js';

const { title, description, sections } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Never an absolute path: both deploy targets live in a subfolder. -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="layout">
      <nav class="nav" aria-label="Sections">
        <div class="nav-title">
          AI-native SDLC
          {/* In the nav, not the footer: the screenshots people take are of the middle of a
              page, and a marker that only appears at the bottom does not survive the crop.
              Production shows nothing — the absence is the signal. [spec D7] */}
          {isPreview && <span class="env-marker">PREVIEW</span>}
        </div>
        {/* Below 60rem this bar is the navigation: where you are on the left, a way in on
            the right. Above it, both are hidden and the list is simply always there. */}
        <div class="nav-bar">
          <span class="nav-here" data-nav-here>
            AI-native SDLC
          </span>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="nav-sections"
          >
            Sections
          </button>
        </div>

        {/* aria-expanded and aria-controls, not just a class: a button whose only state is a
            CSS class is invisible to anything not looking at pixels. */}
        <ol id="nav-sections">
          {sections.map((s: { slug: string; title: string }, i: number) => (
            <li>
              <a href={`#${s.slug}`} data-nav-for={s.slug}>
                <span class="nav-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="nav-t">{s.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <main>
        <slot />
      </main>
    </div>

    <script>
      // Two small behaviours, and the only JavaScript on the page.
      //
      // Everything else here is static by choice, so each of these has to earn its bytes:
      // on a long page with eleven sections, "where am I" and "let me see that diagram
      // properly" are questions the reader genuinely has, and no amount of CSS answers them.

      // --- 1. Mark the section currently being read -------------------------------------
      // rootMargin pins the trigger line near the top of the viewport rather than the
      // middle, so the heading you are reading is the one highlighted — not the one
      // half-scrolled below it.
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('[data-nav-for]').forEach((a) => {
        links.set(a.dataset.navFor!, a);
      });

      const sections = [...document.querySelectorAll<HTMLElement>('.section[id]')];
      let current: string | null = null;

      // One piece of state, two readers: the highlight in the list, and the label in the
      // mobile bar. They cannot disagree about which section you are in, because there is
      // only one answer. [spec D4]
      const here = document.querySelector<HTMLElement>('[data-nav-here]');
      const hereDefault = here?.textContent ?? '';

      const setCurrent = (id: string | null) => {
        if (id === current) return;
        if (current) links.get(current)?.removeAttribute('aria-current');
        if (id) links.get(id)?.setAttribute('aria-current', 'true');
        current = id;

        if (here) {
          const link = id ? links.get(id) : null;
          const n = link?.querySelector('.nav-n')?.textContent ?? '';
          const t = link?.querySelector('.nav-t')?.textContent ?? '';
          here.textContent = link ? `${n} · ${t}` : hereDefault;
        }
      };

      if ('IntersectionObserver' in window && sections.length) {
        const visible = new Set<string>();
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = (entry.target as HTMLElement).id;
              if (entry.isIntersecting) visible.add(id);
              else visible.delete(id);
            }
            // Document order wins, so scrolling up and down gives the same answer.
            const first = sections.find((s) => visible.has(s.id));
            if (first) setCurrent(first.id);
          },
          { rootMargin: '-12% 0px -70% 0px', threshold: 0 },
        );
        sections.forEach((s) => observer.observe(s));
      }

      // --- 1b. Open and close the list on small screens ----------------------------------
      // CSS decides whether any of this is visible; the script only tracks open/closed, so
      // there is no breakpoint duplicated between the two.
      const nav = document.querySelector<HTMLElement>('.nav');
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');

      if (nav && toggle) {
        const setOpen = (open: boolean) => {
          nav.toggleAttribute('data-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        };

        toggle.addEventListener('click', () => {
          setOpen(!nav.hasAttribute('data-open'));
        });

        // A menu that stays open over the thing you just navigated to is a menu you have to
        // dismiss twice.
        nav.querySelectorAll('a[data-nav-for]').forEach((a) => {
          a.addEventListener('click', () => setOpen(false));
        });
      }

      // --- 2. Let the diagram be looked at properly --------------------------------------
      // Inline, it scales to fit the column, which makes the 9px trigger labels unreadable.
      // Rather than a scrollbar — which hides half the diagram and gives no hint that there
      // is more — a button hands the whole thing the screen.
      const figure = document.querySelector<HTMLElement>('.diagram');
      const button = document.querySelector<HTMLButtonElement>('.diagram-expand');

      if (figure && button && figure.requestFullscreen) {
        const label = () => {
          const open = document.fullscreenElement === figure;
          button.textContent = open ? 'Close' : 'Expand';
          button.setAttribute(
            'aria-label',
            open ? 'Close the diagram' : 'Expand the diagram to full screen',
          );
        };
        button.addEventListener('click', () => {
          if (document.fullscreenElement === figure) document.exitFullscreen();
          else figure.requestFullscreen().catch(() => {});
        });
        document.addEventListener('fullscreenchange', label);
        label();
      } else if (button) {
        // No Fullscreen API: say nothing rather than offer a button that does nothing.
        button.hidden = true;
      }
    </script>
  </body>
</html>
