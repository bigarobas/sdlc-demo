---
import Base from '../layouts/Base.astro';
// The pipeline diagram, inlined rather than linked. An <img> could not inherit the page's
// colours; an inline SVG reads the same CSS variables as everything else, so it themes for
// free instead of needing a light and a dark copy. Generated by `npm run diagram`.
import pipelineSvg from '../generated/pipeline.svg?raw';
import { build, commitUrl, prUrl, builtAtLabel } from '../lib/build-info.js';

// Sections are markdown files, loaded by filename order. Using import.meta.glob rather than
// a content collection keeps this working across Astro majors, where the collections API has
// moved more than once — and it means adding a section is adding one file, which is exactly
// the shape of change an agent handles well.
const modules = import.meta.glob('../content/sections/*.md', { eager: true });

const sections = Object.entries(modules)
  .map(([path, mod]: [string, any]) => ({
    path,
    slug: mod.frontmatter.slug,
    title: mod.frontmatter.title,
    stage: mod.frontmatter.stage,
    Content: mod.Content,
  }))
  .sort((a, b) => a.path.localeCompare(b.path));

const navItems = sections.map(({ slug, title }) => ({ slug, title }));
---

<Base
  title="The AI-native SDLC, built by one"
  description="A static site explaining the AI-native SDLC, produced by the SDLC it describes."
  sections={navItems}
>
  {sections.map(({ slug, title, stage, Content }, i) => (
    <section class="section" id={slug}>
      <div class="section-index">
        {String(i + 1).padStart(2, '0')}
        {stage ? ` · ${stage}` : ''}
      </div>
      <h1>{title}</h1>
      <Content />
      {slug === 'pipeline' && (
        <figure class="diagram">
          <button class="diagram-expand" type="button">
            Expand
          </button>
          <div class="diagram-canvas" set:html={pipelineSvg} />
        </figure>
      )}
    </section>
  ))}

  <footer>
    <p>
      Built with the process it describes. Every artifact, hook and workflow referenced here is in{' '}
      <a href="https://github.com/bigarobas/sdlc-demo">bigarobas/sdlc-demo</a>.
    </p>

    {/* What this build is. Every value comes from the build itself; anything that cannot be
        determined is absent rather than invented. [intent 0001] */}
    {build && (
      <p class="build-info">
        <span class={`build-env build-env-${build.env}`}>{build.env}</span>
        {build.sha &&
          (commitUrl ? (
            <a href={commitUrl}>
              <code>{build.sha}</code>
            </a>
          ) : (
            <code>{build.sha}</code>
          ))}
        {build.pr && prUrl && <a href={prUrl}>#{build.pr}</a>}
        {build.dirty && <span class="build-dirty">uncommitted changes</span>}
        <span class="build-time">{builtAtLabel()}</span>
      </p>
    )}
  </footer>
</Base>
